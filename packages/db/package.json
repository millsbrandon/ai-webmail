{
	"name": "@ai-webmail/db",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		"./client": "./src/client.ts",
		"./schema": "./src/schema.ts"
	},
	"scripts": {
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
		"typecheck": "tsc --noEmit",
		"test:unit": "tsx --test src/client.unit.test.ts"
	},
	"dependencies": {
		"drizzle-orm": "0.45.3",
		"pg": "8.23.1"
	},
	"devDependencies": {
		"@types/pg": "8.15.5",
		"drizzle-kit": "0.31.11",
		"tsx": "4.23.15"
	}
}

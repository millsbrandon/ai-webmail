{
	"name": "@ai-webmail/web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "node ../../scripts/next.mjs dev apps/web",
		"build": "node ../../scripts/next.mjs build apps/web",
		"start": "node ../../scripts/next.mjs start apps/web",
		"typecheck": "tsc --noEmit",
		"test:unit": "tsx --test app/api/health/route.unit.test.ts app/design-system/contrast.unit.test.ts",
		"test:integration": "node --env-file-if-exists=../../.env --import tsx --test app/api/health/route.integration.test.ts",
		"test:e2e": "playwright test --config=playwright.config.mts"
	},
	"dependencies": {
		"@ai-webmail/db": "*",
		"lucide-react": "1.53.0",
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.63.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"tsx": "4.23.15",
		"typescript": "6.0.3"
	}
}
